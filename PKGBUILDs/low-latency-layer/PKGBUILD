# Maintainer: ShivaOS Team <contact@shivaos.com>
# Source: https://github.com/Korthos-Software/low_latency_layer
# Couche Vulkan implicite — Reflex + Anti-Lag sur tous les GPU
# Usage Steam : PROTON_FORCE_NVAPI=1 LOW_LATENCY_LAYER_REFLEX=1 LOW_LATENCY_LAYER_SPOOF_NVIDIA=1 %command%
pkgname=low-latency-layer
pkgver=0.2.0
pkgrel=1
pkgdesc="Vulkan implicit layer — Reflex + Anti-Lag pour tous les GPU"
arch=('x86_64')
url="https://github.com/Korthos-Software/low_latency_layer"
license=('MIT')
depends=('vulkan-icd-loader')
makedepends=('cmake' 'vulkan-headers' 'ninja' 'git')
source=("low_latency_layer::git+https://github.com/Korthos-Software/low_latency_layer.git#tag=v${pkgver}")
sha256sums=('SKIP')

pkgver() {
    cd "low_latency_layer"
    # Retourne la dernière version depuis les tags git (ex: v0.2.0 → 0.2.0)
    git describe --tags --abbrev=0 | sed 's/^v//'
}

build() {
    cd "low_latency_layer"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build build
}

package() {
    cd "low_latency_layer"
    DESTDIR="$pkgdir" cmake --install build
}
