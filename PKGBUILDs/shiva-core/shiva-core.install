post_install() {
    # Importer la clé GPG ShivaOS pour la vérification des paquets
    if ! pacman-key --list-keys contact@shivaos.com &>/dev/null; then
        curl -sL https://shivaos.com/arch-repo/shivaos.gpg | pacman-key --add - 2>/dev/null || \
        curl -sL https://freuja-wq.github.io/shivaos-arch-repo/shivaos.gpg | pacman-key --add - 2>/dev/null || true
        pacman-key --lsign-key contact@shivaos.com 2>/dev/null || true
    fi

    # Activer les services gaming
    systemctl enable shiva-amd-epp.service 2>/dev/null || true
    systemctl enable shiva-irq.service 2>/dev/null || true
    systemctl enable shiva-qos.service 2>/dev/null || true
    systemctl enable shiva-temp-alert.timer 2>/dev/null || true

    # Ajouter le repo shivaos à pacman.conf si pas déjà présent
    if ! grep -q '\[shivaos\]' /etc/pacman.conf 2>/dev/null; then
        printf '\nInclude = /etc/pacman.d/shivaos.conf\n' >> /etc/pacman.conf
        grep -q 'Include = /etc/pacman.d/shivaos.conf' /etc/pacman.conf && \
            sed -i '/^Include = \/etc\/pacman.d\/shivaos.conf/i [shivaos]' /etc/pacman.conf || true
    fi

    # IgnorePkg pour kernel ShivaOS — évite que pacman -Syu écrase linux-shivaos
    if ! grep -q 'IgnorePkg.*linux' /etc/pacman.conf 2>/dev/null; then
        sed -i 's/^#IgnorePkg.*$/IgnorePkg = linux linux-headers/' /etc/pacman.conf
    fi

    # Lien /etc/os-release
    ln -sf /usr/lib/os-release /etc/os-release 2>/dev/null || true

    echo "ShivaOS Core installé — redémarrez pour activer tous les paramètres."
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable shiva-amd-epp.service 2>/dev/null || true
    systemctl disable shiva-irq.service 2>/dev/null || true
    systemctl disable shiva-qos.service 2>/dev/null || true
    systemctl disable shiva-temp-alert.timer 2>/dev/null || true
}
