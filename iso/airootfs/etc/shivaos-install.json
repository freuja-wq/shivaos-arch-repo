{
    "additional-repositories": ["multilib"],
    "audio_config": {"audio": "pipewire"},
    "bootloader": "Grub",
    "hostname": "shivaos",
    "kernels": ["linux-shivaos"],
    "locale_config": {
        "kb_layout": "fr",
        "sys_enc": "UTF-8",
        "sys_lang": "fr_FR"
    },
    "network_config": {"type": "nm"},
    "ntp": true,
    "packages": [
        "shiva-core", "shiva-branding", "shiva-store", "shiva-ai",
        "shiva-ai-overlay", "shiva-pulse", "shiva-welcome",
        "shiva-amd", "shiva-nvidia", "low-latency-layer",
        "gamemode", "gamescope", "mangohud", "steam",
        "fastfetch", "flatpak", "xdg-desktop-portal", "xdg-desktop-portal-kde",
        "firefox", "dolphin", "konsole", "kate", "ark", "spectacle",
        "python", "python-pyqt6",
        "gstreamer", "gst-plugins-good", "gst-plugins-bad",
        "gst-plugins-ugly", "gst-libav",
        "mesa", "lib32-mesa",
        "vulkan-radeon", "lib32-vulkan-radeon",
        "vulkan-intel", "lib32-vulkan-intel",
        "vulkan-icd-loader", "lib32-vulkan-icd-loader",
        "libva-mesa-driver", "lib32-libva-mesa-driver",
        "xf86-video-amdgpu", "xf86-video-nouveau",
        "nvidia-open", "nvidia-utils", "lib32-nvidia-utils",
        "lib32-gamemode",
        "wine", "winetricks"
    ],
    "profile_config": {
        "profile": {"classtype": "DesktopProfile", "details": ["KDE"]}
    },
    "swap": true,
    "timezone": "Europe/Paris"
}
